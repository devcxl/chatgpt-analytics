{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowJs": false
  },
  "include": ["entrypoints/**/*", "utils/**/*", "wxt.config.ts"],
  "exclude": ["node_modules", "dist", ".output"]
}
